# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/salon_db
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
# Set to false only when testing over plain http://localhost
COOKIE_SECURE=true
